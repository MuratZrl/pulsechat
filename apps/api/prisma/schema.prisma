generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomType {
  CHANNEL
  DM
}

model User {
  id            String            @id @default(cuid())
  // Uniqueness is enforced by a case-insensitive functional index in
  // migration 20260502010000_unique_user_name (CREATE UNIQUE INDEX
  // ON "User" (LOWER(name))). Prisma can't natively express functional
  // indexes via @unique, so this field is intentionally not annotated —
  // the constraint is real, just lives at the DB level.
  name          String
  email         String            @unique
  passwordHash  String
  bio           String            @default("")
  avatarUrl     String?
  // Identifier of a built-in preset avatar (e.g. "cat", "fox"). Mutually
  // exclusive with avatarUrl at the application layer — see UsersService.
  // No DB-level enum so adding a new preset is a frontend-only change.
  avatarPreset  String?
  emailVerified Boolean           @default(false)
  createdAt     DateTime          @default(now())
  rooms        RoomMember[]
  messages     Message[]
  createdRooms Room[]            @relation("RoomCreator")
  reactions    MessageReaction[]
  mentions     Mention[]
  pins         Pin[]
  stars        Star[]
  invites      RoomInvite[]
  readReceipts ReadReceipt[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  // Set when the token is exchanged for a new pair. The row stays usable for
  // a short grace window so concurrent refreshes (two tabs) aren't treated as
  // reuse; after that, presenting it again revokes the user's sessions.
  rotatedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Room {
  id          String       @id @default(cuid())
  name        String
  type        RoomType     @default(CHANNEL)
  // Nullable so deleting the creator's account keeps the room (SET NULL).
  createdById String?
  createdBy   User?        @relation("RoomCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  // Channels every new user auto-joins and anyone may join without an
  // invite. An explicit flag, so a user-created room named "General" can't
  // pass for one.
  isDefault   Boolean      @default(false)
  members     RoomMember[]
  messages    Message[]
  pins        Pin[]
  stars       Star[]
  invites     RoomInvite[]
}

model RoomInvite {
  id          String   @id @default(cuid())
  code        String   @unique @default(cuid())
  roomId      String
  createdById String
  createdAt   DateTime @default(now())
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([roomId]) // only one active invite per room
}

model RoomMember {
  userId     String
  roomId     String
  role       String   @default("member")
  joinedAt   DateTime @default(now())
  lastReadAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
}

model Message {
  id         String            @id @default(cuid())
  roomId     String
  // Nullable so a deleted account's tombstoned messages survive (SET NULL).
  senderId   String?
  text       String            @default("")
  createdAt  DateTime          @default(now())
  editedAt   DateTime?
  isDeleted  Boolean           @default(false)
  replyToId  String?
  attachment Json?
  forwarded  Json?
  room       Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender     User?             @relation(fields: [senderId], references: [id], onDelete: SetNull)
  replyTo    Message?          @relation("MessageReplies", fields: [replyToId], references: [id])
  replies    Message[]         @relation("MessageReplies")
  reactions  MessageReaction[]
  mentions   Mention[]
  pins         Pin[]
  stars        Star[]
  readReceipts ReadReceipt[]

  @@index([roomId, createdAt])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model Mention {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model Pin {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  roomId    String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model Star {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  roomId    String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model ReadReceipt {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}
