DATABASE_URL="postgresql://postgres:postgres@localhost:5432/realtime_chat?schema=public"

JWT_SECRET="change-me-to-a-random-32-char-string"
JWT_REFRESH_SECRET="change-me-to-a-different-random-32-char-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

REDIS_HOST="localhost"
REDIS_PORT=6379

PORT=3001
FRONTEND_URL="http://localhost:3000"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@realtime-chat.app"
